@model CatalogItem
@{ ViewData["Title"] = "Cadastrar item"; }
<a asp-action="Index" class="back-link">← Voltar ao catálogo</a><span class="eyebrow">Sua coleção, seus detalhes</span><h1 class="catalog-title">Cadastrar item</h1>
<form class="surface form-surface" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <partial name="_CatalogForm" model="Model" />
    <div class="d-flex gap-2 mt-4 form-actions"><button type="submit" class="btn btn-primary">Cadastrar</button><a asp-action="Index" class="btn btn-outline-secondary">Voltar</a></div>
</form>
