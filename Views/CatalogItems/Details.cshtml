@model CatalogItem
@{ ViewData["Title"] = "Detalhes"; }
<h1 class="catalog-title">Detalhes do item</h1>
<div class="card"><div class="card-body">
    <h2 class="h4">@Model.Title @if (Model.IsFavorite) { <span class="favorite-icon">♥</span> }</h2>
    <dl class="row mb-0">
        <dt class="col-sm-3">Tipo</dt><dd class="col-sm-9">@Model.Type</dd>
        <dt class="col-sm-3">Autor ou diretor</dt><dd class="col-sm-9">@Model.AuthorOrDirector</dd>
        <dt class="col-sm-3">Ano</dt><dd class="col-sm-9">@Model.ReleaseYear</dd>
        <dt class="col-sm-3">Gênero</dt><dd class="col-sm-9">@Model.Genre</dd>
        <dt class="col-sm-3">Descrição</dt><dd class="col-sm-9" style="white-space:pre-wrap">@Model.Description</dd>
        <dt class="col-sm-3">Favorito</dt><dd class="col-sm-9">@(Model.IsFavorite ? "Sim" : "Não")</dd>
    </dl>
</div></div>
<div class="d-flex gap-2 mt-3"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a><a asp-action="Index" class="btn btn-outline-secondary">Voltar</a></div>
