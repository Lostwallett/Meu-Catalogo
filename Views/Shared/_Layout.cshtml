<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - MyCatalog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" asp-append-version="true" href="~/css/site.css" />
</head>
<body>
    <header class="border-bottom bg-white mb-4">
        <nav class="navbar navbar-expand-lg container py-3">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">📚 MyCatalog</a>
            <div class="ms-auto d-flex gap-3">
                <a class="nav-link" asp-controller="Home" asp-action="Index">Início</a>
                <a class="nav-link" asp-controller="CatalogItems" asp-action="Index">Meu Catálogo</a>
            </div>
        </nav>
    </header>
    <main class="container pb-5">
        @if (TempData["Mensagem"] is string mensagem)
        {
            <div class="alert alert-success" role="status">@mensagem</div>
        }
        @RenderBody()
    </main>
    <footer class="border-top py-3 text-center text-muted">MyCatalog · Projeto de estudo ASP.NET Core MVC</footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
