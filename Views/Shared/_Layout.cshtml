@{ var currentController = ViewContext.RouteData.Values["controller"]?.ToString(); }
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#245e4d" />
    <title>@ViewData["Title"] · Meu Catálogo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" asp-append-version="true" href="~/css/site.css" />
</head>
<body>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <header class="site-header">
        <nav class="container site-nav" aria-label="Navegação principal">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark" aria-hidden="true">m.</span>Meu Catálogo</a>
            <div class="nav-links">
                <a class="nav-link @(currentController == "Home" ? "active" : "")" aria-current="@(currentController == "Home" ? "page" : null)" asp-controller="Home" asp-action="Index">Início</a>
                <a class="nav-link @(currentController == "CatalogItems" ? "active" : "")" aria-current="@(currentController == "CatalogItems" ? "page" : null)" asp-controller="CatalogItems" asp-action="Index">Meu catálogo</a>
            </div>
        </nav>
    </header>
    <main id="conteudo" class="container pb-4" tabindex="-1">
        @if (TempData["Mensagem"] is string mensagem)
        {
            <div class="alert alert-success" role="status">@mensagem</div>
        }
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2"><span class="fw-semibold">Meu Catálogo</span><span>Um lugar para suas próximas descobertas.</span></div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
